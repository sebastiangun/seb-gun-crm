# Copy these values into Render -> Environment Variables.
# NEVER commit a real VK token to GitHub.
VK_TOKEN=
VK_COMMUNITY=
VK_COMMUNITY_URL=

# Optional CRM settings
ALLOW_LOCAL_PHRASE_FALLBACK=1
COOKIE_SECURE=1
API_TIMEOUT_MS=18000
BS_QUEUE_MAX_WAIT_MS=10000
BS_ORG_BUSY_RETRIES=1
# PUBLIC_BASE_URL=https://your-service.onrender.com

# v25.6 independent local transcription.
# No GROQ_API_KEY / OPENAI_API_KEY and no separate STT service are required.
STT_ENABLED=1
STT_LANGUAGE=ru
STT_MODEL=whisper.cpp/tiny-q5_1
STT_MODEL_PATH=models/ggml-tiny-q5_1.bin
STT_THREADS=1
STT_TIMEOUT_MS=300000
STT_IDLE_RELEASE_MS=600000


# v26.3 Telegram SLA notifications. NEVER commit real secrets.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=yozhiki_sebastian_bot
TELEGRAM_WEBHOOK_SECRET=
NOTIFICATION_CHECK_SECRET=
BLUESALES_NOTIFICATION_LOGIN=
BLUESALES_NOTIFICATION_PASSWORD=
NOTIFICATION_TIMEZONE=Europe/Moscow
# v28.9: paste the value exported by an administrator in CRM → More.
NOTIFICATION_RULES_JSON=[]
# Legacy one-manager fallback (optional).
NOTIFICATION_DEFAULT_CHAT_ID=
NOTIFICATION_DEFAULT_MANAGER=0.1 Сергей К.
NOTIFICATION_DEFAULT_MANAGER_FILTERS=
NOTIFICATION_DEFAULT_STATUSES=
NOTIFICATION_DEFAULT_SLA_MINUTES=8
NOTIFICATION_DEFAULT_WORK_START=10:00
NOTIFICATION_DEFAULT_WORK_END=22:00

# One business clock used by reminders, quick dates and UI formatting.
APP_TIMEZONE=Europe/Moscow

# Optional: stable encryption secret for resumable HttpOnly sessions
SESSION_SECRET=
